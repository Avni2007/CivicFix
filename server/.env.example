# CivicFix Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civicfix
JWT_SECRET=your_jwt_secret_key_here_change_in_production
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Optional AI Engine Key (OpenAI / Gemini API) - Leave blank for offline heuristic + OpenCV fallback mode
AI_API_KEY=

# Gmail SMTP Configuration for Email OTP Verification
# SMTP_USER must be your Gmail address.
# SMTP_PASS must be a 16-character Gmail APP PASSWORD (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords (requires Google 2-Step Verification enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="CivicFix India" <yourgmail@gmail.com>
